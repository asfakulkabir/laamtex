# ----------------------------------------------------------------------------
# Document root = project root (same layout as cPanel's /public_html).
# The front controller is index.php at this level; static assets and uploaded
# files are served from the public/ and storage/app/public folders through it.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Upload limits for the slider video uploader (mod_php only).
#
# SliderController accepts a 50 MB video. The stock php.ini caps uploads at 2M
# and the whole POST at 8M, so a large video dies before validation runs and the
# admin sees an empty form instead of an error. 64M leaves headroom above the
# app's own limit, which stays the one that reports the problem.
#
# .user.ini covers CGI/FPM hosts; this block covers mod_php.
# ----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_file_uploads 20
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ------------------------------------------------------------------------
    # Security: never let Apache serve dotfiles or the .env file directly.
    # ------------------------------------------------------------------------
    <FilesMatch "^(\.env|\.env\.example|\.env\.backup|\.env\.production|\.gitignore|\.gitattributes|\.editorconfig|\.user\.ini|\.DS_Store)$">
        Require all denied
    </FilesMatch>

    RedirectMatch 403 ^/\.env
    RedirectMatch 403 ^/\.git

    # ------------------------------------------------------------------------
    # Security: block project folders/files that must never hit the browser.
    # ------------------------------------------------------------------------
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|tests|vendor)/ - [F,L]
    RewriteRule ^(storage/framework|storage/logs|storage/app/private)/ - [F,L]
    RewriteRule ^(artisan|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js)(/|$) - [F,L]
    RewriteRule ^cpanel_env\.txt - [F,L]

    # ------------------------------------------------------------------------
    # Handle Authorization Header
    # ------------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ------------------------------------------------------------------------
    # Redirect Trailing Slashes If Not A Folder...
    # ------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ------------------------------------------------------------------------
    # Send Requests To Front Controller (index.php serves assets, uploads and
    # forwards every other request to Laravel).
    # ------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>